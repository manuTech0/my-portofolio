# Application
APP_ENV=development
PORT=3001

# Allowed frontend origins (CORS). Comma separated, no spaces.
ALLOW_DOMAIN=http://localhost:5173,https://manu-tech.my.id,https://www.manu-tech.my.id

# Trust X-Forwarded-For/X-Real-IP only when running behind a trusted proxy.
TRUST_PROXY=false

# Cloudflare Turnstile (Managed mode). Use separate keys per environment.
# Development: disabled by default via TURNSTILE_DISABLED=true
TURNSTILE_DISABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AAAAAAAAAAAAAAA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AAAAAAAAAAAAAAA
# Production (example):
# TURNSTILE_DISABLED=false
# TURNSTILE_SITE_KEY_PROD=
# TURNSTILE_SECRET_KEY_PROD=

# Expected values verified on every Turnstile token.
TURNSTILE_EXPECTED_HOSTNAME=localhost
TURNSTILE_EXPECTED_ACTION=contact
TURNSTILE_TIMEOUT_MS=5000

# Rate limiting (sliding window, configurable)
# 4 requests / 10s -> 30 min penalty
# 4 requests / 1h  -> 2 min penalty
# 8 requests / 1h  -> 90 min penalty
# 20 requests / 1h -> 24 h penalty
MAX_PENALTY_DURATION_MS=2592000000
PENALTY_ESCALATION_BASE=2

# Idempotency records are kept 24 hours by default.
IDEMPIOTENCY_TTL_MS=86400000
ABUSE_RETENTION_MS=604800000
MAX_BODY_BYTES=65536
TURNSTILE_TOKEN_TTL_MS=300000

# Shared rate-limit store for distributed environments (Redis). Comment out to use in-memory store.
# REDIS_URL=redis://localhost:6379

# JWT secret for HS256 session tokens (protects server↔frontend contact channel).
# Generate: openssl rand -base64 32
JWT_SECRET=

# Telegram bot (optional). When set, every accepted contact message is forwarded to the chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Session cookie
SESSION_COOKIE_NAME=mp_sid
SESSION_TTL_MS=2592000000
